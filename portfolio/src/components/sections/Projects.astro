---
import Eyebrow from '../Eyebrow.astro';
import Headline from '../Headline.astro';
import { projects } from '../../data/profile';
---

<section id="projects" class="bg-ink text-cream">
	<div class="mx-auto max-w-7xl px-4 py-24 sm:px-8 sm:py-32">
		<Eyebrow class="text-sage">Proyek</Eyebrow>
		<Headline text="Karya *pilihan*" class="mt-4 text-[clamp(2.75rem,8vw,7rem)]" emClass="text-lime" />

		<ul class="mt-14 border-t border-cream/15">
			{projects.map((project) => (
				<li class="group relative border-b border-cream/15 transition-colors hover:bg-lime hover:text-ink" data-reveal>
					<div class="grid gap-3 px-2 py-8 md:grid-cols-[5rem_minmax(0,1fr)_minmax(0,22rem)_auto] md:items-center md:gap-8 md:px-4">
						<p class="font-mono text-xs tabular-nums text-sage group-hover:text-ink/70">{project.year}</p>

						<h3 class="wide text-2xl font-extrabold uppercase leading-tight tracking-tight sm:text-3xl">
							<a href={project.repo} target="_blank" rel="noopener" class="after:absolute after:inset-0">
								{project.title}
							</a>
						</h3>

						<div class="min-w-0">
							<p class="text-sm leading-relaxed text-cream/70 group-hover:text-ink/80">{project.description}</p>
							<p class="mt-2 font-mono text-xs text-lime group-hover:text-ink">{project.tech.join(' / ')}</p>
						</div>

						<div class="relative z-10 flex items-center gap-3">
							{project.demo && (
								<a
									href={project.demo}
									target="_blank"
									rel="noopener"
									class="rounded-md px-3 py-1.5 font-mono text-xs uppercase ring-1 ring-current transition hover:bg-ink hover:text-lime"
								>
									Demo
								</a>
							)}
							<span class="grid h-11 w-11 place-items-center rounded-full ring-1 ring-current transition-transform group-hover:-rotate-45" aria-hidden="true">
								→
							</span>
						</div>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>
