---
import Contours from '../Contours.astro';
import Eyebrow from '../Eyebrow.astro';
import { Image } from 'astro:assets';
import { profile, about } from '../../data/profile';

// Garis bantu layout: ubah ke false untuk menyembunyikan
const debugLayout = false;

// Bentuk folder dalam koordinat 400×500 (rasio 4:5)
const folderPath =
	'M2 50Q2 26 26 26L104 26C118 26 122 2 138 2L262 2C278 2 282 26 296 26L374 26Q398 26 398 50' +
	'L398 456Q398 480 374 480L352 480C338 480 334 498 320 498L80 498C66 498 62 480 48 480L26 480Q2 480 2 456Z';

const [first, ...rest] = profile.name.split(' ');
const school = about.education[0]?.school;

const facts = [
	{ label: 'Lokasi', value: profile.location },
	...(school ? [{ label: 'Kampus', value: school }] : []),
	{ label: 'Fokus', value: profile.focus },
];
---

<!--
	Hirarki: foto (blok gelap terbesar) → nama → peran & tagline → tombol → fakta singkat.
	Latar 3D sengaja diredam dan ditutup gradasi krem di area teks agar teks tetap terbaca.
-->
<section id="top" class="relative isolate overflow-hidden bg-cream text-ink" data-debug-layout={debugLayout || undefined}>
	<div class="absolute inset-0 -z-20" aria-hidden="true">
		<Contours class="hero-fallback-bg absolute inset-0 h-full w-full text-sage/60" seed={3} />
		<canvas id="hero-canvas" class="absolute inset-0 h-full w-full opacity-0"></canvas>
	</div>
	<div
		class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(180deg,transparent_30%,var(--color-cream)_62%)] md:bg-[linear-gradient(90deg,transparent_30%,color-mix(in_oklab,var(--color-cream)_85%,transparent)_52%,var(--color-cream)_70%)]"
		aria-hidden="true"
	>
	</div>

	<div
		data-hero
		class="mx-auto grid max-w-7xl items-center gap-10 px-4 pb-14 pt-24 sm:px-8 md:min-h-[min(100svh,980px)] md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:gap-14 md:pb-16 md:pt-28 lg:gap-20"
	>
		<!-- Foto -->
		<figure
			class="hero-figure relative mx-auto w-full max-w-[20rem] sm:max-w-[24rem] md:max-w-[85%]"
			data-interval={profile.photoInterval}
		>
			<!--
				Bingkai folder: tab menonjol di tengah atas, sudut bawah kiri-kanan sedikit naik.
				Path yang sama dipakai untuk garis (tanpa isi) dan untuk memotong foto.
			-->
			<div class="relative aspect-[4/5]">
				<svg class="absolute h-0 w-0" aria-hidden="true">
					<clipPath id="hero-folder-clip" clipPathUnits="objectBoundingBox" transform="scale(0.0025 0.002)">
						<path d={folderPath} />
					</clipPath>
				</svg>

				<!-- Latar dalam folder: krem tipis untuk meredam garis 3D, pola titik, dan cahaya lime lembut di belakang kepala -->
				<div class="absolute inset-0 [clip-path:url(#hero-folder-clip)]" aria-hidden="true">
					<div class="absolute inset-0 bg-cream/75"></div>
					<div class="absolute inset-0 bg-[radial-gradient(var(--color-sage)_1px,transparent_1.3px)] bg-[size:14px_14px] opacity-70"></div>
					<div class="hero-photo-glow absolute left-[7.5%] top-[4%] aspect-square w-[85%] rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--color-lime)_45%,transparent),transparent)]"></div>
				</div>

				{profile.photos.length > 0 ? (
					<div class="hero-photo-stage absolute inset-0 [clip-path:url(#hero-folder-clip)]">
						<!-- Foto sudah 4:5, jadi pas dengan folder. object-[50%_50%] = geser posisi bila perlu. -->
						{profile.photos.map((photo, i) => (
							<Image
								src={photo}
								alt={i === 0 ? `Foto ${profile.name}` : ''}
								width={1200}
								height={Math.round((1200 * photo.height) / photo.width)}
								widths={[480, 720, 1000, 1200]}
								sizes="(min-width: 768px) 40vw, 80vw"
								format="webp"
								quality={82}
								loading={i === 0 ? 'eager' : 'lazy'}
								fetchpriority={i === 0 ? 'high' : 'auto'}
								class:list={['hero-photo absolute inset-0 h-full w-full object-cover object-[50%_50%]', i > 0 && 'invisible opacity-0']}
							/>
						))}
					</div>
				) : (
					<p class="absolute inset-x-0 top-1/2 -translate-y-1/2 text-center font-mono text-[11px] uppercase tracking-[0.2em] text-moss">
						Foto kamu di sini
					</p>
				)}

				<svg
					class="pointer-events-none absolute inset-0 h-full w-full overflow-visible text-ink"
					viewBox="0 0 400 500"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path class="hero-folder-line" pathLength="1" d={folderPath} />
				</svg>
			</div>

			{profile.status && (
				<figcaption class="hero-sticker absolute -right-3 bottom-10 rotate-[-4deg] rounded-md bg-lime px-3 py-2 font-mono text-[11px] font-medium uppercase tracking-wider text-ink shadow-[3px_3px_0_var(--color-ink)] sm:-right-5">
					<span class="mr-1.5 inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-ink align-middle"></span>
					{profile.status}
				</figcaption>
			)}
		</figure>

		<!-- Teks -->
		<div class="min-w-0">
			<Eyebrow class="hero-fade text-moss">Halo, saya</Eyebrow>

			<h1 class="mt-5 uppercase leading-[0.9]">
				<span class="block overflow-hidden pb-1">
					<span class="hero-line block font-display text-[clamp(2.75rem,6.2vw,5.75rem)]">{first}</span>
				</span>
				<span class="block overflow-hidden pb-1">
					<span class="hero-line wide block text-[clamp(2.1rem,4.9vw,4.6rem)] font-extrabold tracking-tight">{rest.join(' ')}</span>
				</span>
			</h1>

			<p class="hero-fade mt-6 text-xl font-semibold sm:text-2xl">{profile.role}</p>
			<p class="hero-fade mt-3 max-w-[46ch] text-lg leading-relaxed text-ink/75">{profile.tagline}</p>

			<div class="hero-fade mt-8 flex flex-wrap gap-3">
				<a
					href="#projects"
					class="rounded-lg bg-ink px-5 py-3 text-xs font-bold uppercase tracking-wider text-cream transition hover:bg-lime hover:text-ink"
				>
					Lihat Proyek
				</a>
				<a
					href={profile.cvUrl}
					target="_blank"
					class="rounded-lg bg-cream px-5 py-3 text-xs font-bold uppercase tracking-wider ring-1 ring-ink/25 transition hover:bg-ink hover:text-cream"
				>
					Download CV
				</a>
			</div>

			<dl class="hero-fade mt-10 grid grid-cols-1 gap-4 border-t border-ink/15 pt-6 sm:grid-cols-3">
				{facts.map((fact) => (
					<div class="min-w-0">
						<dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-moss">{fact.label}</dt>
						<dd class="mt-1 font-semibold">{fact.value}</dd>
					</div>
				))}
			</dl>
		</div>
	</div>
</section>

<style is:global>
	/* pathLength="1" + dasharray 1 → GSAP menggambar garis folder dengan menggeser dashoffset 1 → 0 */
	.hero-folder-line { stroke-dasharray: 1; }

	/* Garis bantu layout hero. Pakai outline (bukan border) agar ukuran elemen tidak berubah.
	   Warna menandakan kedalaman: merah → biru → magenta → oranye → cyan. */
	#top[data-debug-layout] div { outline: 2px solid #ff1f1f; outline-offset: -2px; }
	#top[data-debug-layout] div div { outline-color: #1f5bff; }
	#top[data-debug-layout] div div div { outline-color: #ff00d4; }
	#top[data-debug-layout] div div div div { outline-color: #ff8a00; }
	#top[data-debug-layout] div div div div div { outline-color: #00c8ff; }
</style>

<script>
	import { gsap } from 'gsap';
	import { initHeroScene } from '../../scripts/heroScene';

	const figure = document.querySelector<HTMLElement>('.hero-figure');
	const photos = gsap.utils.toArray<HTMLElement>('.hero-photo');
	const counter = document.querySelector('[data-photo-index]');
	const interval = Number(figure?.dataset.interval) || 5;

	// Ganti foto otomatis: foto lama memudar ke atas, foto baru naik dari bawah
	let current = 0;
	const showNext = () => {
		const next = (current + 1) % photos.length;
		gsap
			.timeline()
			.to(photos[current], { autoAlpha: 0, yPercent: -3, duration: 0.6, ease: 'power2.in' })
			.fromTo(photos[next], { autoAlpha: 0, yPercent: 5 }, { autoAlpha: 1, yPercent: 0, duration: 0.8, ease: 'power3.out' }, '-=0.25')
			.fromTo('.hero-photo-glow', { scale: 0.85 }, { scale: 1, duration: 1.2, ease: 'power2.out' }, '<');
		current = next;
		if (counter) counter.textContent = String(next + 1).padStart(2, '0');
	};
	const slideshow = gsap.delayedCall(interval, function tick() {
		showNext();
		slideshow.restart(true);
	}).pause();

	const mm = gsap.matchMedia();

	mm.add(
		{ motion: '(prefers-reduced-motion: no-preference)', reduce: '(prefers-reduced-motion: reduce)' },
		(ctx) => {
			if (ctx.conditions?.reduce) {
				gsap.set('[data-hero]', { autoAlpha: 1 });
				return;
			}

			gsap
				.timeline({
					defaults: { ease: 'power3.out' },
					// Mulai berganti foto setelah intro selesai
					onComplete: () => {
						if (photos.length > 1) slideshow.restart(true);
					},
				})
				.set('[data-hero]', { autoAlpha: 1 })
				// 1. Garis folder tergambar, lalu foto naik dari dalam folder
				.from('.hero-folder-line', { strokeDashoffset: 1, duration: 1.2, ease: 'power2.inOut' })
				.from(photos[0] ?? [], { yPercent: 10, autoAlpha: 0, duration: 1.1 }, '-=0.7')
				// 2. Nama naik baris per baris
				.from('.hero-line', { yPercent: 110, duration: 0.9, stagger: 0.1 }, '-=0.55')
				// 3. Sisanya menyusul pelan
				.from('.hero-fade', { y: 16, autoAlpha: 0, duration: 0.7, stagger: 0.07 }, '-=0.5')
				.from('.hero-sticker', { scale: 0, rotate: -25, duration: 0.55, ease: 'back.out(2)' }, '-=0.45');

			return () => slideshow.pause();
		},
	);

	// Hover (hanya perangkat dengan mouse): folder sedikit miring mengikuti kursor,
	// foto bergeser berlawanan arah (paralaks), dan pergantian foto berhenti sementara.
	mm.add('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
		if (!figure) return;
		const frame = figure.firstElementChild as HTMLElement;
		gsap.set(frame, { transformPerspective: 900 });

		const tiltX = gsap.quickTo(frame, 'rotationX', { duration: 0.5, ease: 'power3.out' });
		const tiltY = gsap.quickTo(frame, 'rotationY', { duration: 0.5, ease: 'power3.out' });
		const shiftX = gsap.quickTo('.hero-photo-stage', 'x', { duration: 0.6, ease: 'power3.out' });

		const onMove = (e: PointerEvent) => {
			const r = figure.getBoundingClientRect();
			const px = (e.clientX - r.left) / r.width - 0.5;
			const py = (e.clientY - r.top) / r.height - 0.5;
			tiltY(px * 6);
			tiltX(-py * 6);
			shiftX(-px * 10);
		};
		const onEnter = () => {
			slideshow.pause();
			gsap.to('.hero-photo-glow', { scale: 1.12, duration: 0.6, ease: 'power2.out' });
		};
		const onLeave = () => {
			tiltX(0);
			tiltY(0);
			shiftX(0);
			gsap.to('.hero-photo-glow', { scale: 1, duration: 0.6, ease: 'power2.out' });
			if (photos.length > 1 && slideshow.paused()) slideshow.restart(true);
		};

		figure.addEventListener('pointermove', onMove);
		figure.addEventListener('pointerenter', onEnter);
		figure.addEventListener('pointerleave', onLeave);
		return () => {
			figure.removeEventListener('pointermove', onMove);
			figure.removeEventListener('pointerenter', onEnter);
			figure.removeEventListener('pointerleave', onLeave);
		};
	});

	// Latar 3D dimuat setelah konten utama tampil agar teks tidak menunggu
	const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
	const start = () =>
		canvas &&
		initHeroScene(canvas).then((ok) => {
			if (!ok) return;
			gsap.to(canvas, { opacity: 1, duration: 1.6, ease: 'power2.out' });
			gsap.to('.hero-fallback-bg', { opacity: 0, duration: 1.6, ease: 'power2.out' });
		});

	if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
	else setTimeout(start, 300);
</script>
